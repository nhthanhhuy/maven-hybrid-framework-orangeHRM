<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Orange HRM">
    
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"></listener>
        <listener class-name="reportConfig.AllureListener"></listener>
    </listeners>

    <parameter name="url" value="http://localhost/orangehrm5/web/index.php/auth/login"></parameter>

    <test name="Test on Chrome">
        <parameter name="browser" value="CHROME"></parameter>
        <classes>
            <class name="testcases.employee.Employee_01_NewEmployee" />
        </classes>
    </test>

    <test name="Test on Edge">
        <parameter name="browser" value="Edge"></parameter>
        <classes>
            <class name="testcases.employee.Employee_01_NewEmployee" />
        </classes>
    </test>

    <test name="Test on Firefox">
        <parameter name="browser" value="FIREFOX"></parameter>
        <classes>
            <class name="testcases.employee.Employee_01_NewEmployee" />
        </classes>
    </test>

</suite>